{
  "name": "bmi-calc",
  "version": "2.0.0",
  "private": true,
  "description": "Ideální BMI – kalkulačka BMI a další zdravotní kalkulačky",
  "scripts": {
    "clean": "rimraf _site",
    "build:css": "tailwindcss -i ./src/css/tailwind.css -o ./_site/css/app.css --minify",
    "build:eleventy": "eleventy",
    "build": "npm run clean && npm run build:eleventy && npm run build:css",
    "watch:css": "tailwindcss -i ./src/css/tailwind.css -o ./_site/css/app.css --watch",
    "watch:eleventy": "eleventy --serve --quiet",
    "dev": "npm-run-all build:eleventy --parallel watch:css watch:eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "luxon": "^3.7.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.10",
    "tailwindcss": "^3.4.17"
  }
}
