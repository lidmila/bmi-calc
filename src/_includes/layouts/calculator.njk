---
layout: layouts/base.njk
---

<section class="container-x py-12 lg:py-16">
  <header class="max-w-3xl mx-auto text-center relative">
    <p class="text-xs uppercase tracking-[0.25em] text-flame-600 font-bold">{{ tag or "Kalkulačka" }}</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-balance leading-[1.05]">
      {{ title | safe }}
    </h1>
    {% if perex %}<p class="mt-5 text-lg text-ink/75 dark:text-slate-300 text-pretty">{{ perex }}</p>{% endif %}
    {% if dateModified %}
      <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Aktualizováno {{ dateModified | dateCZ }}</p>
    {% endif %}
  </header>

  <div class="max-w-3xl mx-auto mt-10 relative">
    {# tape effect on calculator card #}
    <div class="absolute left-1/2 -translate-x-1/2 -top-3 w-32 h-7 bg-flame-300/60 -rotate-2 z-10 pointer-events-none" aria-hidden="true"></div>
    {{ content | safe }}
  </div>

  {# AdSense slot at bottom of calculator page #}
  <div class="max-w-3xl mx-auto mt-12">
    {% set slot = "9044571605" %}
    {% set format = "auto" %}
    {% include "partials/ad.njk" %}
  </div>

  {% if sources %}
    <aside class="max-w-3xl mx-auto mt-12 rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40 p-6">
      <h2 class="font-display text-xl font-bold text-slate-900 dark:text-slate-100">Zdroje</h2>
      <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
        {% for s in sources %}
          <li>· <a href="{{ s.url }}" rel="nofollow noopener" target="_blank" class="hover:text-brand-700 underline">{{ s.label }}</a></li>
        {% endfor %}
      </ul>
    </aside>
  {% endif %}

  <aside class="max-w-3xl mx-auto mt-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-paper dark:bg-slate-900/40 p-6 flex items-start gap-4">
    <img src="/img/lidmila-marsalkova.png" alt="Lidmila Maršálková" width="64" height="64" class="h-14 w-14 sm:h-16 sm:w-16 rounded-full object-cover flex-shrink-0">
    <div class="text-sm">
      <p class="font-semibold text-slate-900 dark:text-slate-100">Píše Lidmila Maršálková</p>
      <p class="text-slate-600 dark:text-slate-400 mt-1">Obsahová strategička a copywriterka, která za Ideálním BMI stojí. Zdroji jsou WHO, CDC, NICE, ÚZIS a recenzované studie z PubMed. Více o tom, jak píšu obsah, najdete na stránce <a href="/o-nas/" class="text-brand-700 hover:text-brand-800 underline">O nás</a>.</p>
    </div>
  </aside>
</section>
