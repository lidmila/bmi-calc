---
layout: layouts/base.njk
---

<section class="container-x py-12 lg:py-16">
  <header class="max-w-3xl mx-auto text-center relative">
    <p class="text-xs uppercase tracking-[0.25em] text-flame-600 font-bold">{{ tag or "Kalkulačka" }}</p>
    <h1 class="mt-3 font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-balance leading-[1.05]">
      {{ title | safe }}
    </h1>
    {% if perex %}<p class="mt-5 text-lg text-ink/75 dark:text-slate-300 text-pretty">{{ perex }}</p>{% endif %}
  </header>

  <div class="max-w-3xl mx-auto mt-10 relative">
    {# tape effect on calculator card #}
    <div class="absolute left-1/2 -translate-x-1/2 -top-3 w-32 h-7 bg-flame-300/60 -rotate-2 z-10 pointer-events-none" aria-hidden="true"></div>
    {{ content | safe }}
  </div>
</section>
