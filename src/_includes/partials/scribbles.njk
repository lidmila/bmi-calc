{# Hand-drawn SVG snippets — used inline. Pass as macros or use {% include %} variants. #}

{% macro squiggle(color="#f97316") %}
<svg viewBox="0 0 220 12" preserveAspectRatio="none" aria-hidden="true">
  <path d="M2 8 Q 22 -2, 44 6 T 88 6 T 132 6 T 176 6 T 218 6"
        fill="none" stroke="{{ color }}" stroke-width="3" stroke-linecap="round"/>
</svg>
{% endmacro %}

{% macro circle(color="#f97316") %}
<svg viewBox="0 0 200 80" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true">
  <path d="M 30 40 C 30 15, 95 8, 150 14 S 195 50, 170 65 S 80 75, 35 60 S 28 45, 30 40 Z"
        fill="none" stroke="{{ color }}" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="2 4" opacity="0.85"/>
</svg>
{% endmacro %}

{% macro arrow(color="#0b1420", className="") %}
<svg viewBox="0 0 80 80" class="{{ className }}" fill="none" stroke="{{ color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M 8 14 C 24 32, 36 40, 56 36"/>
  <path d="M 50 26 L 56 36 L 46 40"/>
</svg>
{% endmacro %}

{% macro star(color="#f97316", className="") %}
<svg viewBox="0 0 32 32" class="{{ className }}" fill="{{ color }}" aria-hidden="true">
  <path d="M16 2 L18 12 L28 14 L20 20 L23 30 L16 24 L9 30 L12 20 L4 14 L14 12 Z" stroke="{{ color }}" stroke-width="0" stroke-linejoin="round"/>
</svg>
{% endmacro %}

{% macro dotsBlob(className="") %}
<svg viewBox="0 0 200 200" class="{{ className }}" aria-hidden="true">
  <defs>
    <pattern id="dotPat" x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.6" fill="currentColor"/>
    </pattern>
  </defs>
  <rect width="200" height="200" fill="url(#dotPat)"/>
</svg>
{% endmacro %}

{% macro waveDivider(color="#0d9488") %}
<svg viewBox="0 0 1200 40" preserveAspectRatio="none" class="block w-full h-8" aria-hidden="true">
  <path d="M0 20 Q 100 0, 200 20 T 400 20 T 600 20 T 800 20 T 1000 20 T 1200 20" fill="none" stroke="{{ color }}" stroke-width="2"/>
</svg>
{% endmacro %}
