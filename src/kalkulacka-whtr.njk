<script>
document.getElementById('form-whtr').addEventListener('submit', function (e) {
  e.preventDefault();
  var h = parseFloat(document.getElementById('whtr-height').value);
  var w = parseFloat(document.getElementById('whtr-waist').value);
  if (!h || !w) return;
  var r = w / h;
  document.getElementById('whtr-out').textContent = r.toFixed(2).replace('.', ',');
  var cat = document.getElementById('whtr-cat'), tip = document.getElementById('whtr-tip');
  if (r < 0.4) { cat.textContent = 'Štíhlý / atletický'; cat.className = 'badge mt-3 bg-blue-100 text-blue-900'; tip.textContent = 'Velmi nízké riziko, ale velmi nízká hodnota může u žen znamenat podváhu.'; }
  else if (r < 0.5) { cat.textContent = 'Nízké riziko'; cat.className = 'badge mt-3 bg-emerald-100 text-emerald-900'; tip.textContent = 'Skvělé. Pas pod polovinou výšky = nízké zdravotní riziko.'; }
  else if (r < 0.6) { cat.textContent = 'Zvýšené riziko'; cat.className = 'badge mt-3 bg-amber-100 text-amber-900'; tip.textContent = 'Doporučujeme zaměřit se na obvod pasu – kombinace stravy a pohybu zaměřená na viscerální tuk.'; }
  else { cat.textContent = 'Vysoké riziko'; cat.className = 'badge mt-3 bg-red-100 text-red-900'; tip.textContent = 'Vysoké zdravotní riziko, doporučujeme konzultaci s lékařem nebo nutričním terapeutem.'; }
  document.getElementById('whtr-result').classList.remove('hidden');
});
</script>
