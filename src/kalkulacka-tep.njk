---
layout: layouts/calculator.njk
title: "Kalkulačka tepových zón"
description: "Pět tepových zón pro spalování tuků, vytrvalost a maximální výkon. Počítáme z věku a klidové tepovky."
permalink: /kalkulacka-tep/
tag: "Sport & tep"
perex: "Spalování tuků se nejlépe odehrává v zóně 60–70 % maximální tepové frekvence. Zadejte věk a uvidíte své zóny."
---

<div class="card p-6 sm:p-8">
  <form id="form-hr" class="grid gap-4 sm:grid-cols-2" novalidate>
    <div><label class="label" for="hr-age">Věk (roky)</label><input class="input" type="number" id="hr-age" min="15" max="90" placeholder="např. 35" required></div>
    <div><label class="label" for="hr-rest">Klidový tep (volitelné)</label><input class="input" type="number" id="hr-rest" min="35" max="100" placeholder="např. 62"></div>
    <div class="sm:col-span-2"><button type="submit" class="btn-primary w-full">Spočítat zóny</button></div>
  </form>
  <div id="hr-result" class="hidden mt-8 pt-8 border-t border-slate-200 dark:border-slate-800">
    <p class="text-sm text-slate-500 mb-4">Maximální tep <strong id="hr-max">–</strong> bpm. Při zadaném klidovém tepu používáme přesnější Karvonenův vzorec.</p>
    <div class="space-y-3" id="hr-zones"></div>
  </div>
</div>

<div class="prose prose-slate dark:prose-invert max-w-none mt-10">
  <h2>Jak zóny používat</h2>
  <p>Maximální tep odhadujeme jako <em>208 − 0,7 × věk</em> (Tanaka, 2001) – přesnější než staré 220 − věk. S klidovým tepem počítáme tepovou rezervu (<em>Karvonen</em>) a získáme výrazně přesnější zóny.</p>
  <p>Pro spalování tuků jsou nejlepší zóny 2 a 3. Pro zlepšení vytrvalosti zóna 3 a 4. Zóna 5 je krátké intervaly.</p>
</div>

<script>
document.getElementById('form-hr').addEventListener('submit', function (e) {
  e.preventDefault();
  var a = parseInt(document.getElementById('hr-age').value, 10);
  var rest = parseInt(document.getElementById('hr-rest').value, 10) || 0;
  if (!a) return;
  var max = Math.round(208 - 0.7 * a);
  document.getElementById('hr-max').textContent = max;
  var zones = [
    { name: 'Zóna 1 – Regenerace', range: [0.50, 0.60], desc: 'Lehká chůze, rozcvička, regenerace.', tone: 'blue' },
    { name: 'Zóna 2 – Spalování tuků', range: [0.60, 0.70], desc: 'Klidné kardio, dlouhé výlety, ideální pro hubnutí.', tone: 'emerald' },
    { name: 'Zóna 3 – Aerobní', range: [0.70, 0.80], desc: 'Střední intenzita, zlepšuje aerobní kapacitu.', tone: 'amber' },
    { name: 'Zóna 4 – Anaerobní práh', range: [0.80, 0.90], desc: 'Tempa, intervaly. Krátké úseky.', tone: 'orange' },
    { name: 'Zóna 5 – Maximum', range: [0.90, 1.00], desc: 'Krátké sprinty, VO₂ max trénink.', tone: 'red' }
  ];
  var html = zones.map(function (z) {
    var lo, hi;
    if (rest > 0) { lo = Math.round((max - rest) * z.range[0] + rest); hi = Math.round((max - rest) * z.range[1] + rest); }
    else { lo = Math.round(max * z.range[0]); hi = Math.round(max * z.range[1]); }
    return '<div class="flex items-center justify-between gap-3 rounded-2xl border border-' + z.tone + '-200 bg-' + z.tone + '-50 dark:bg-' + z.tone + '-900/20 dark:border-' + z.tone + '-800 px-4 py-3">' +
      '<div><p class="font-semibold text-' + z.tone + '-900 dark:text-' + z.tone + '-100">' + z.name + '</p>' +
      '<p class="text-xs text-slate-600 dark:text-slate-400">' + z.desc + '</p></div>' +
      '<p class="font-mono font-semibold text-slate-800 dark:text-slate-200 tabular-nums">' + lo + '–' + hi + ' bpm</p></div>';
  }).join('');
  document.getElementById('hr-zones').innerHTML = html;
  document.getElementById('hr-result').classList.remove('hidden');
});
</script>
