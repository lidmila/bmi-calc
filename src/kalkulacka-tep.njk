<script>
document.getElementById('form-hr').addEventListener('submit', function (e) {
  e.preventDefault();
  var a = parseInt(document.getElementById('hr-age').value, 10);
  var rest = parseInt(document.getElementById('hr-rest').value, 10) || 0;
  if (!a) return;
  var max = Math.round(208 - 0.7 * a);
  document.getElementById('hr-max').textContent = max;
  var zones = [
    { name: 'Zóna 1 – Regenerace', range: [0.50, 0.60], desc: 'Lehká chůze, rozcvička, regenerace.', tone: 'blue' },
    { name: 'Zóna 2 – Spalování tuků', range: [0.60, 0.70], desc: 'Klidné kardio, dlouhé výlety, ideální pro hubnutí.', tone: 'emerald' },
    { name: 'Zóna 3 – Aerobní', range: [0.70, 0.80], desc: 'Střední intenzita, zlepšuje aerobní kapacitu.', tone: 'amber' },
    { name: 'Zóna 4 – Anaerobní práh', range: [0.80, 0.90], desc: 'Tempa, intervaly. Krátké úseky.', tone: 'orange' },
    { name: 'Zóna 5 – Maximum', range: [0.90, 1.00], desc: 'Krátké sprinty, VO₂ max trénink.', tone: 'red' }
  ];
  var html = zones.map(function (z) {
    var lo, hi;
    if (rest > 0) { lo = Math.round((max - rest) * z.range[0] + rest); hi = Math.round((max - rest) * z.range[1] + rest); }
    else { lo = Math.round(max * z.range[0]); hi = Math.round(max * z.range[1]); }
    return '<div class="flex items-center justify-between gap-3 rounded-2xl border border-' + z.tone + '-200 bg-' + z.tone + '-50 dark:bg-' + z.tone + '-900/20 dark:border-' + z.tone + '-800 px-4 py-3">' +
      '<div><p class="font-semibold text-' + z.tone + '-900 dark:text-' + z.tone + '-100">' + z.name + '</p>' +
      '<p class="text-xs text-slate-600 dark:text-slate-400">' + z.desc + '</p></div>' +
      '<p class="font-mono font-semibold text-slate-800 dark:text-slate-200 tabular-nums">' + lo + '–' + hi + ' bpm</p></div>';
  }).join('');
  document.getElementById('hr-zones').innerHTML = html;
  document.getElementById('hr-result').classList.remove('hidden');
});
</script>
