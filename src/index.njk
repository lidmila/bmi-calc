{# ==================== Calculator ==================== #}
<section id="kalkulacka" class="container-x py-12 lg:py-20 relative">
  <div class="max-w-4xl mx-auto relative">
    {# tape effect on calculator card #}
    <div class="absolute left-1/2 -translate-x-1/2 -top-3 w-32 h-7 bg-flame-300/70 -rotate-2 z-10" aria-hidden="true"></div>

    <div class="card p-6 sm:p-10" id="calculator">
      <div class="flex flex-wrap items-end justify-between gap-3 mb-7">
        <div>
          <p class="text-[10px] uppercase tracking-[0.25em] text-flame-600 font-bold">Krok 01</p>
          <h2 class="mt-1 font-display text-3xl sm:text-4xl font-bold">Spočítejte si BMI</h2>
        </div>
        <div role="tablist" class="inline-flex rounded-full border-2 border-ink/15 p-1 bg-paper">
          <button class="tab-pill" role="tab" aria-selected="true" data-tab-pill="basic">Základ</button>
          <button class="tab-pill" role="tab" aria-selected="false" data-tab-pill="advanced">Podrobně</button>
          <button class="tab-pill" role="tab" aria-selected="false" data-tab-pill="children">Děti</button>
        </div>
      </div>

      <div data-tab-panel="basic">
        <form id="form-basic" novalidate class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="basic-height">Výška <span class="text-ink/40 dark:text-slate-500 font-normal">(cm)</span></label>
            <input class="input" type="number" id="basic-height" min="100" max="250" step="1" placeholder="např. 175" required>
          </div>
          <div>
            <label class="label" for="basic-weight">Hmotnost <span class="text-ink/40 dark:text-slate-500 font-normal">(kg)</span></label>
            <input class="input" type="number" id="basic-weight" min="20" max="300" step="0.1" placeholder="např. 72" required>
          </div>
          <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
            <button type="submit" class="btn-primary">Spočítat BMI →</button>
            <p class="text-sm text-ink/60 dark:text-slate-400 italic">…nebo prostě piště, počítá se živě.</p>
          </div>
        </form>
      </div>

      <div data-tab-panel="advanced" class="hidden">
        <form id="form-advanced" novalidate class="grid gap-4 sm:grid-cols-2">
          <div><label class="label" for="adv-height">Výška <span class="text-ink/40 dark:text-slate-500 font-normal">(cm)</span></label><input class="input" type="number" id="adv-height" min="100" max="250" step="1" placeholder="např. 175" required></div>
          <div><label class="label" for="adv-weight">Hmotnost <span class="text-ink/40 dark:text-slate-500 font-normal">(kg)</span></label><input class="input" type="number" id="adv-weight" min="20" max="300" step="0.1" placeholder="např. 72" required></div>
          <div><label class="label" for="adv-gender">Pohlaví</label>
            <select class="input" id="adv-gender" required>
              <option value="">Vyberte…</option><option value="male">Muž</option><option value="female">Žena</option>
            </select>
          </div>
          <div><label class="label" for="adv-age">Věk <span class="text-ink/40 dark:text-slate-500 font-normal">(roky)</span></label><input class="input" type="number" id="adv-age" min="18" max="120" step="1" placeholder="např. 35" required></div>
          <div class="sm:col-span-2"><label class="label" for="adv-waist">Obvod pasu <span class="text-ink/40 dark:text-slate-500 font-normal">(cm) – volitelné, zpřesní výsledek</span></label><input class="input" type="number" id="adv-waist" min="40" max="200" step="0.1" placeholder="např. 85"></div>
          <div class="sm:col-span-2"><button type="submit" class="btn-primary">Spočítat podrobné BMI →</button></div>
        </form>
      </div>

      <div data-tab-panel="children" class="hidden">
        <form id="form-children" novalidate class="grid gap-4 sm:grid-cols-2">
          <div><label class="label" for="child-gender">Pohlaví</label>
            <select class="input" id="child-gender" required>
              <option value="">Vyberte…</option><option value="male">Chlapec</option><option value="female">Dívka</option>
            </select>
          </div>
          <div><label class="label" for="child-age-years">Věk <span class="text-ink/40 dark:text-slate-500 font-normal">(roky)</span></label><input class="input" type="number" id="child-age-years" min="2" max="19" step="1" placeholder="např. 10" required></div>
          <div><label class="label" for="child-age-months">Měsíce <span class="text-ink/40 dark:text-slate-500 font-normal">(0–11)</span></label><input class="input" type="number" id="child-age-months" min="0" max="11" step="1" value="0"></div>
          <div><label class="label" for="child-height">Výška <span class="text-ink/40 dark:text-slate-500 font-normal">(cm)</span></label><input class="input" type="number" id="child-height" min="50" max="200" step="0.1" placeholder="např. 140" required></div>
          <div class="sm:col-span-2"><label class="label" for="child-weight">Hmotnost <span class="text-ink/40 dark:text-slate-500 font-normal">(kg)</span></label><input class="input" type="number" id="child-weight" min="5" max="150" step="0.1" placeholder="např. 35" required></div>
          <div class="sm:col-span-2"><button type="submit" class="btn-primary">Spočítat BMI dítěte →</button></div>
        </form>
      </div>

      <div id="calc-result" class="hidden mt-10 pt-8 border-t-2 border-dashed border-ink/15">
        <p class="text-[10px] uppercase tracking-[0.25em] text-flame-600 font-bold mb-3">Krok 02 · Výsledek</p>
        <div class="grid gap-8 lg:grid-cols-2 items-center">
          <div class="relative">
            <svg viewBox="0 0 240 140" class="w-full max-w-sm mx-auto">
              <defs>
                <linearGradient id="bmiArc" x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0" stop-color="#60a5fa"/>
                  <stop offset="0.32" stop-color="#10b981"/>
                  <stop offset="0.55" stop-color="#fbbf24"/>
                  <stop offset="0.78" stop-color="#f97316"/>
                  <stop offset="1" stop-color="#7f1d1d"/>
                </linearGradient>
              </defs>
              <path d="M20 120 A 100 100 0 0 1 220 120" stroke="url(#bmiArc)" stroke-width="18" fill="none" stroke-linecap="round"/>
              <g class="text-[10px] fill-ink/50" font-family="Inter">
                <text x="20" y="138" text-anchor="middle">16</text>
                <text x="59" y="40" text-anchor="middle">18,5</text>
                <text x="120" y="20" text-anchor="middle">25</text>
                <text x="181" y="40" text-anchor="middle">30</text>
                <text x="220" y="138" text-anchor="middle">40+</text>
              </g>
              <g id="gauge-needle" style="transform-origin: 120px 120px; transition: transform .8s cubic-bezier(.34,1.56,.64,1);">
                <line x1="120" y1="120" x2="120" y2="38" stroke="#0b1420" stroke-width="4" stroke-linecap="round"/>
                <circle cx="120" cy="120" r="9" fill="#0b1420"/>
                <circle cx="120" cy="120" r="3" fill="#fffaf3"/>
              </g>
            </svg>
            <p id="gauge-value-text" class="text-center font-display text-6xl font-bold text-ink dark:text-slate-50 -mt-2">–</p>
            <p class="text-center text-xs uppercase tracking-[0.2em] text-ink/50 dark:text-slate-400 mt-1">Vaše BMI</p>
          </div>

          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-ink/50 dark:text-slate-400 mb-2">Hodnocení</p>
            <p id="result-value" class="hidden"></p>
            <span id="result-category" class="badge bg-paper border border-ink/10 text-ink dark:bg-slate-800 dark:text-slate-100 dark:border-slate-700">–</span>
            <div id="result-details" class="mt-4 text-pretty"></div>
            <div id="goal-box" class="mt-4"></div>

            <div class="mt-6 flex flex-wrap gap-2">
              <button id="share-result" class="btn-secondary text-sm">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Sdílet
              </button>
              <a href="/jak-snizit-bmi/" class="btn-flame text-sm">Co s tím dál? →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{# ==================== HOW IT WORKS – three steps ==================== #}
<section class="container-x py-12 lg:py-16">
  <div class="grid gap-10 lg:grid-cols-3">
    {% set steps = [
      {n:"01", title:"Změřte se doma", body:"Bez svršků, ráno před snídaní. Výšku změřte naboso, hmotnost na osobní váze.", tilt:"tilt-l"},
      {n:"02", title:"Zadejte do kalkulačky", body:"Vyšlete pár čísel. Žádný účet, žádný e-mail. Hodnoty zůstávají u vás v prohlížeči.", tilt:""},
      {n:"03", title:"Pochopte, co znamenají", body:"Ne jen číslo. Vysvětlíme zónu podle WHO, doporučení pro váš věk a co dělat dál.", tilt:"tilt-r"}
    ] %}
    {% for s in steps %}
      <div class="relative {{ s.tilt }}">
        <div class="stamp absolute -top-4 -left-2 z-10 {% if loop.index == 2 %}stamp-flame{% else %}stamp-brand{% endif %}">{{ s.n }}</div>
        <div class="card p-7 pt-10">
          <h3 class="font-display text-2xl font-bold">{{ s.title }}</h3>
          <p class="mt-3 text-ink/75 dark:text-slate-300 text-pretty">{{ s.body }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

